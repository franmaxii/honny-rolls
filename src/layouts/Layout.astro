---
import { Font } from "astro:assets";
import Icons from "../components/Icons.astro";
import { STORE } from "../data/config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${STORE.name} · Menú`,
  description = "Rolls de canela esponjositos, horneados en el día. Armá tu pedido y envialo por WhatsApp.",
} = Astro.props;

// Con `site` configurado en astro.config.mjs la imagen sale con URL absoluta (mejor para WhatsApp/redes)
const ogImage = Astro.site ? new URL("/og-image.jpg", Astro.site).href : "/og-image.jpg";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FEEAB8" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <Font cssVariable="--font-mochiy" preload />
    <Font cssVariable="--font-nunito" />
  </head>
  <body>
    <Icons />
    <slot />
  </body>
</html>
