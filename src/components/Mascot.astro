---
// Conejito inspirado en el logo. El carrito le cambia el humor con data-mood.
interface Props {
  mood?: "happy" | "sad" | "love";
  id?: string;
  class?: string;
}
const { mood = "happy", id, class: className } = Astro.props;
---
<div class:list={["mascot", className]} id={id} data-mood={mood} aria-hidden="true">
  <svg viewBox="0 0 120 104">
    <g class="mascot__ears">
      <g transform="rotate(-10 44 30)">
        <ellipse cx="44" cy="30" rx="12" ry="25" fill="#F89A5E" stroke="#E9733A" stroke-width="3.5" />
        <ellipse cx="44" cy="33" rx="5" ry="15" fill="#FFF3D6" />
      </g>
      <g transform="rotate(10 76 30)">
        <ellipse cx="76" cy="30" rx="12" ry="25" fill="#F89A5E" stroke="#E9733A" stroke-width="3.5" />
        <ellipse cx="76" cy="33" rx="5" ry="15" fill="#FFF3D6" />
      </g>
    </g>
    <ellipse cx="60" cy="70" rx="50" ry="30" fill="#FFF3D6" stroke="#E9733A" stroke-width="11" />
    <ellipse cx="60" cy="70" rx="50" ry="30" fill="none" stroke="#F89A5E" stroke-width="6" />
    <ellipse cx="37" cy="76" rx="7" ry="4.6" fill="#F5894E" />
    <ellipse cx="83" cy="76" rx="7" ry="4.6" fill="#F5894E" />
    <g class="m-happy">
      <ellipse cx="44" cy="64" rx="5.5" ry="4.2" fill="#FFF3D6" stroke="#F07838" stroke-width="3" />
      <ellipse cx="76" cy="64" rx="5.5" ry="4.2" fill="#FFF3D6" stroke="#F07838" stroke-width="3" />
      <path d="M53 73q3.5 4.5 7 0q3.5 4.5 7 0" fill="none" stroke="#E9733A" stroke-width="2.6" stroke-linecap="round" />
      <path d="M57.5 76.2q2.5 4 5 0" fill="#F5894E" />
    </g>
    <g class="m-sad">
      <path d="M39 64q5 -4 10 0M71 64q5 -4 10 0" fill="none" stroke="#E9733A" stroke-width="3" stroke-linecap="round" />
      <path d="M55 77q5 -4 10 0" fill="none" stroke="#E9733A" stroke-width="2.6" stroke-linecap="round" />
      <path d="M86 66q3 5 0 7q-3 -2 0 -7z" fill="#9AD4F5" />
    </g>
    <g class="m-love">
      <path d="M38 65q6 -7 12 0M70 65q6 -7 12 0" fill="none" stroke="#E9733A" stroke-width="3" stroke-linecap="round" />
      <path d="M53 73q3.5 4.5 7 0q3.5 4.5 7 0" fill="none" stroke="#E9733A" stroke-width="2.6" stroke-linecap="round" />
      <path d="M57.5 76.2q2.5 4 5 0" fill="#F5894E" />
    </g>
  </svg>
</div>

<style>
  .mascot svg { width: 100%; height: auto; overflow: visible; }
  .m-happy,
  .m-sad,
  .m-love { display: none; }
  .mascot[data-mood="happy"] .m-happy,
  .mascot[data-mood="sad"] .m-sad,
  .mascot[data-mood="love"] .m-love { display: inline; }
  .mascot__ears { transform-origin: 60px 55px; }
  .mascot:global(.wiggle) .mascot__ears { animation: ears .6s ease; }
  .mascot:global(.wiggle) svg { animation: bump .6s cubic-bezier(.3, 1.6, .5, 1); }
  @keyframes ears {
    25% { transform: rotate(-6deg); }
    60% { transform: rotate(5deg); }
  }
</style>
