---
import type { Product } from "../data/menu";
import { formatPrice } from "../data/config";
import AddButton from "./AddButton.astro";

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
---
<div class="extra" data-card={p.id}>
  <span class="extra__swirl"><svg aria-hidden="true"><use href="#i-swirl" /></svg></span>
  <span class="extra__info">
    <span class="extra__name">{p.name}</span>
    <span class="extra__price">{formatPrice(p.price)}</span>
  </span>
  <div class="qty" data-qty={p.id}><AddButton id={p.id} name={p.name} /></div>
</div>

<style>
  .extra {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .6rem .7rem .6rem .9rem;
    background: var(--paper);
    border: 3px solid var(--orange-line);
    border-radius: 999px;
    box-shadow: var(--pop-sm);
  }
  .extra:global(.in-cart) { background: #FFF6E2; }
  .extra__swirl {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--peach);
    color: var(--orange-line);
  }
  .extra__swirl svg { width: 26px; height: 26px; }
  .extra__info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .extra__name { font-weight: 900; line-height: 1.25; }
  .extra__price { color: var(--orange-ink); font-weight: 900; font-size: .95rem; }

  /* En extras el botón es solo el "+" (el contenido lo re-arma el JS, por eso :global) */
  .extra :global(.add-btn) { width: 44px; padding: .35rem; justify-content: center; }
  .extra :global(.add-btn span) { display: none; }

  @media (min-width: 900px) {
    .extra { border-radius: 24px; }
  }
</style>
